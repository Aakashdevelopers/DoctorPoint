# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Atlas Connection
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/novastore?retryWrites=true&w=majority

# Admin Authorization Settings
# Comma-separated list of admin email addresses (used alongside or in place of Firebase Custom Claims)
ADMIN_EMAILS=admin@novastore.com,dev@novastore.com

# Firebase Admin SDK Configuration
# Option A: Path to service account JSON file
FIREBASE_SERVICE_ACCOUNT_PATH=./src/config/firebase-service-account.json

# Option B: Raw Service Account JSON String (Useful for cloud deployments like Vercel/Render)
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# Firebase Storage Bucket (Optional if using default Firebase bucket)
FIREBASE_STORAGE_BUCKET=novastore-app.appspot.com

# Local Private Storage Path (Fallback directory for uploaded private digital files)
PRIVATE_STORAGE_PATH=./uploads/private
PUBLIC_STORAGE_PATH=./uploads/public

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
