<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/card_speciality"
    android:layout_width="94dp"
    android:layout_height="110dp"
    android:layout_margin="4dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    app:cardBackgroundColor="#F8FAFC"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp"
    app:strokeColor="@color/card_stroke"
    app:strokeWidth="1dp">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ImageView
            android:id="@+id/iv_speciality_image"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="Speciality Image"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_user" />

        <View
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_alignParentBottom="true"
            android:background="@drawable/bg_category_text_scrim" />

        <TextView
            android:id="@+id/tv_speciality_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:layout_marginBottom="6dp"
            android:paddingHorizontal="4dp"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="2"
            android:text="General Physician"
            android:textColor="#0F172A"
            android:textSize="11sp"
            android:textStyle="bold" />

    </RelativeLayout>

</com.google.android.material.card.MaterialCardView>
